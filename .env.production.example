# ==============================================================================
# GBrain Production Environment Template (Coolify / Docker Compose)
#
# Copy to `.env` or paste into Coolify -> Environment Variables.
# Quote values containing special shell characters (`?`, `&`, `$`).
# ==============================================================================

# --- 1. Release Version, Public Endpoint & Reverse Proxy ----------------------
# Pre-compiled `gbrain-linux-x64` release version from GitHub Releases.
# Use `latest` or pin an exact release tag (e.g., `v0.60.613.0`).
GBRAIN_VERSION="latest"

# Domain name & Let's Encrypt email (used by Caddy in `docker-compose.standalone.yml`)
GBRAIN_DOMAIN="gbrain.touchesai.com"
ACME_EMAIL="admin@touchesai.com"

# Public HTTPS origin (NO trailing slash, NO /mcp suffix).
# Must match the domain configured in Coolify or Caddy so OAuth 2.1 issuer metadata
# (`/.well-known/oauth-authorization-server`) matches RFC 8414 §3.3.
GBRAIN_PUBLIC_URL="https://gbrain.touchesai.com"

# Owner Admin Bootstrap Token — authenticates `/admin` dashboard and
# `gbrain mcp admin` / `gbrain mcp grant` CLI calls.
# MUST be >= 32 characters matching [A-Za-z0-9_-]+.
# Generate with: head -c 32 /dev/urandom | base64 | tr -d "+/=" | head -c 48
GBRAIN_ADMIN_BOOTSTRAP_TOKEN="CHANGE_ME_GENERATE_WITH_DEV_URANDOM_32_CHARS_MIN"

# Trust 1 reverse-proxy hop (Coolify's built-in Traefik proxy) for X-Forwarded-For / req.secure
GBRAIN_HTTP_TRUST_PROXY="1"

# --- 2. PostgreSQL Database ---------------------------------------------------
# Option A: Bundled `postgres` service in docker-compose.yml
POSTGRES_USER="gbrain"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PG_PASSWORD"
POSTGRES_DB="gbrain"

# Option B: External / Coolify Standalone PostgreSQL Resource (pgvector:pg16)
# Uncomment to override the bundled postgres service URL:
# GBRAIN_DATABASE_URL="postgresql://gbrain:PASSWORD@<coolify-pg-container-uuid>:5432/gbrain"

# Postgres tuning for pgvector HNSW builds & connection pools
PG_SHARED_BUFFERS="512MB"
PG_MAINTENANCE_WORK_MEM="1GB"
PG_MAX_CONNECTIONS="200"
PG_WORK_MEM="16MB"

# --- 3. OpenRouter (LLM, Embeddings, Expansion, Reranker) ---------------------
# Get key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY="sk-or-v1-CHANGE_ME"
OPENROUTER_REFERER="https://brain.example.com"
OPENROUTER_TITLE="gbrain-prod"

# Embeddings (File-plane; changing later requires `gbrain migrate embeddings`)
# Supported natively in recipe with known dims:
#   - openrouter:openai/text-embedding-3-small (1536, or 512/768/1024)
#   - openrouter:openai/text-embedding-3-large (3072)
#   - openrouter:baai/bge-m3                   (1024)
#   - openrouter:qwen/qwen3-embedding-8b       (4096)
GBRAIN_EMBEDDING_MODEL="openrouter:openai/text-embedding-3-small"
GBRAIN_EMBEDDING_DIMENSIONS="1536"

# Chat, Expansion & Model Tiers
# Note: Subagent loops (`GBRAIN_TIER_SUBAGENT_MODEL`) on OpenRouter MUST use
# `anthropic/*` or `deepseek/*` families (pinned for tool-call abort/resume).
GBRAIN_CHAT_MODEL="openrouter:anthropic/claude-sonnet-4.6"
GBRAIN_EXPANSION_MODEL="openrouter:google/gemini-3-flash-preview"
GBRAIN_TIER_UTILITY_MODEL="openrouter:anthropic/claude-haiku-4.5"
GBRAIN_TIER_REASONING_MODEL="openrouter:anthropic/claude-sonnet-4.6"
GBRAIN_TIER_DEEP_MODEL="openrouter:anthropic/claude-opus-4.7"
GBRAIN_TIER_SUBAGENT_MODEL="openrouter:anthropic/claude-sonnet-4.6"

# Cross-Encoder Reranker via OpenRouter (`/api/v1/rerank`)
# Allowed models in openrouter recipe:
#   - openrouter:cohere/rerank-v3.5
#   - openrouter:cohere/rerank-4-fast
#   - openrouter:cohere/rerank-4-pro
#   - openrouter:nvidia/llama-nemotron-rerank-vl-1b-v2:free
# (Or set `typesafe:jev-1.13.0` if using TypeSafe Jev for reranking)
GBRAIN_RERANKER_MODEL="openrouter:cohere/rerank-v3.5"

# Search Mode preset: conservative | balanced | tokenmax
GBRAIN_SEARCH_MODE="balanced"

# --- 4. System One / Jev Decisions --------------------------------------------
# TypeSafe Jev (`typesafe:jev-1.13.0`) powers sub-second typed decisions (`triage`,
# `conflict`, `rerank`, `evidence`, etc.) via `POST /v1/systemone`.
# Get key at: https://console.typesafe.ai (optional; leave empty to keep slots off
# and route egress fallback to OpenRouter `llm:openrouter:anthropic/claude-haiku-4.5`).
TYPESAFE_API_KEY=""
GBRAIN_DECIDE_EGRESS_PRIVATE="allow"
GBRAIN_DECIDE_ENABLE_RERANK="0"
GBRAIN_DECIDE_DAILY_USD="1.00"

# --- 5. MCP Server, Workers & Autopilot ---------------------------------------
TZ="Asia/Ho_Chi_Minh"
GBRAIN_OAUTH_TOKEN_TTL="3600"
GBRAIN_MCP_SURFACE="full"
GBRAIN_ENABLE_DCR="0"

GBRAIN_WORKER_CONCURRENCY="2"
GBRAIN_JOB_ISOLATION="process"
GBRAIN_WORKER_MAX_RSS_MB="1536"
GBRAIN_ALLOW_SHELL_JOBS="0"
GBRAIN_AUTOPILOT_INTERVAL="300"

# --- 6. Git Checkout & Backups ------------------------------------------------
GBRAIN_GIT_REMOTE_URL=""
GIT_AUTHOR_NAME="GBrain Operator"
GIT_AUTHOR_EMAIL="gbrain@example.com"
GBRAIN_BACKUP_RETENTION_DAYS="14"

